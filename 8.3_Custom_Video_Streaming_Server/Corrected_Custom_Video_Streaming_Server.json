{
  "openapi": "3.0.0",
  "info": {
    "title": "Custom Video Streaming API",
    "version": "1.0",
    "description": "API for ESP32 camera: view live video and control LED."
  },
  "servers": [
    {
      "url": "http://lab1-440.azure-api.net/custom-video-streaming-api",
      "description": "Local host according to sunfounder.com"
    }
  ],
  "paths": {
    "/stream": {
      "get": {
        "summary": "Get live video",
        "responses": {
          "200": {
            "description": "Returns live video stream",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/led": {
      "post": {
        "summary": "Turn LED on or off",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["on", "off"]
                  }
                },
                "required": ["state"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LED state updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get LED state",
        "responses": {
          "200": {
            "description": "Returns current LED state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
